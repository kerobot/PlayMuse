<Window x:Class="PlayMuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlayMuse"
        xmlns:converters="clr-namespace:PlayMuse.Converters"
        mc:Ignorable="d"
        Title="PlayMuse" Height="640" Width="420" MinHeight="480" MinWidth="360">
    <Window.Resources>
        <converters:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー: ファイルを開く / 出力デバイス選択 / 排他モード切替 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="開く" Padding="12,4"
                    Command="{Binding OpenFilesCommand}"/>
            <ComboBox DockPanel.Dock="Right" Width="180"
                      ItemsSource="{Binding Devices}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDevice}"/>
            <CheckBox DockPanel.Dock="Right" Content="排他モード" VerticalAlignment="Center" Margin="0,0,8,0"
                      IsChecked="{Binding IsExclusiveMode}"/>
        </DockPanel>

        <!-- プレイリスト -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding CurrentTrack, Mode=OneWay}"
                 BorderThickness="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick" Handler="TrackItem_MouseDoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- シーク -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding Position, Converter={StaticResource TimeSpanToStringConverter}}"/>
            <Slider Grid.Column="1" VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                    Value="{Binding Position, Converter={StaticResource TimeSpanToSecondsConverter}, Mode=TwoWay}"
                    PreviewMouseDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"/>
        </Grid>

        <!-- 再生系トランスポート + 音量 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="前へ" Padding="10,4" Margin="0,0,4,0" Command="{Binding PreviousCommand}"/>
            <Button Grid.Column="1" Content="再生" Padding="10,4" Margin="0,0,4,0" Command="{Binding PlayCommand}"/>
            <Button Grid.Column="2" Content="一時停止" Padding="10,4" Margin="0,0,4,0" Command="{Binding PauseCommand}"/>
            <Button Grid.Column="3" Content="停止" Padding="10,4" Margin="0,0,4,0" Command="{Binding StopCommand}"/>
            <Button Grid.Column="4" Content="次へ" Padding="10,4" Command="{Binding NextCommand}"/>
            <TextBlock Grid.Column="6" Text="音量" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider Grid.Column="7" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    Value="{Binding Volume}"/>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="4" Margin="0,8,0,0" Opacity="0.8" TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>
