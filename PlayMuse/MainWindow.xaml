<Window x:Class="PlayMuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlayMuse"
        xmlns:converters="clr-namespace:PlayMuse.Converters"
        mc:Ignorable="d"
        Title="PlayMuse" Height="640" Width="440" MinHeight="480" MinWidth="440">
    <Window.Resources>
        <converters:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter"/>
        <converters:SampleRateToStringConverter x:Key="SampleRateToStringConverter"/>
        <converters:DraggingOpacityConverter x:Key="DraggingOpacityConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー: ファイルを開く / 出力デバイス選択 / 排他モード切替 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="開く" Padding="12,4"
                    Command="{Binding OpenFilesCommand}"/>
            <Button DockPanel.Dock="Left" Content="📂" Padding="8,4" Margin="4,0,0,0"
                    ToolTip="プレイリストを開く"
                    Command="{Binding OpenPlaylistCommand}"/>
            <Button DockPanel.Dock="Left" Content="💾" Padding="8,4" Margin="4,0,0,0"
                    ToolTip="プレイリストを保存"
                    Command="{Binding SavePlaylistCommand}"/>
            <ComboBox DockPanel.Dock="Right" Width="180"
                      ItemsSource="{Binding Devices}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDevice}"/>
            <CheckBox DockPanel.Dock="Right" Content="排他モード" VerticalAlignment="Center" Margin="0,0,8,0"
                      IsChecked="{Binding IsExclusiveMode}"/>
        </DockPanel>

        <!-- プレイリスト -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding SelectedTrack}"
                 BorderThickness="1"
                 AllowDrop="True"
                 Grid.IsSharedSizeScope="True"
                 DragOver="TrackList_DragOver"
                 DragLeave="TrackList_DragLeave"
                 Drop="TrackList_Drop">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <EventSetter Event="MouseDoubleClick" Handler="TrackItem_MouseDoubleClick"/>
                    <Setter Property="Opacity">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource DraggingOpacityConverter}">
                                <Binding/>
                                <Binding Path="DataContext.DraggingTrack" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackGrip"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackArt"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackAlbum"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackRemove"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⠿" FontSize="16" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Cursor="SizeAll" ToolTip="ドラッグして並べ替え"
                                   PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                   PreviewMouseMove="DragHandle_PreviewMouseMove"/>
                        <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,8,0"
                                Background="#DDDDDD" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Image Source="{Binding AlbumArtData, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                   Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="90">
                            <TextBlock Text="{Binding Album}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}" FontSize="10" Opacity="0.6"/>
                                <TextBlock Text=" ・ " FontSize="10" Opacity="0.4"/>
                                <TextBlock Text="{Binding SampleRate, Converter={StaticResource SampleRateToStringConverter}}" FontSize="10" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="4" Content="✕" Padding="6,2" VerticalAlignment="Center"
                                ToolTip="プレイリストから削除"
                                Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- オーディオ情報パネル -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" 
                Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1"
                Visibility="{Binding AudioInfoText, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding AudioInfoText}" 
                       FontFamily="Consolas, Courier New" 
                       FontSize="11" 
                       LineHeight="18"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 再生中のトラック情報 -->
        <Grid Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="♪" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTrack.Artist, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" - " Margin="4,0" Opacity="0.7"/>
                <TextBlock Text="{Binding CurrentTrack.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ToggleButton Grid.Column="2" 
                          IsChecked="{Binding IsLoopEnabled}"
                          Padding="8,2"
                          Margin="8,0,0,0"
                          ToolTip="ループ再生">
                <TextBlock>
                    <Run Text="🔁"/>
                </TextBlock>
            </ToggleButton>
        </Grid>

        <!-- シーク -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding Position, Converter={StaticResource TimeSpanToStringConverter}}"/>
            <Slider Grid.Column="1" VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                    Value="{Binding Position, Converter={StaticResource TimeSpanToSecondsConverter}, Mode=TwoWay}"
                    PreviewMouseDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"/>
        </Grid>

        <!-- 再生系トランスポート + 音量 -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="前へ" Padding="10,4" Margin="0,0,4,0" Command="{Binding PreviousCommand}"/>
            <Button Grid.Column="1" Content="{Binding PlayPauseButtonText}" Padding="10,4" Margin="0,0,4,0" Command="{Binding PlayPauseCommand}"/>
            <Button Grid.Column="2" Content="次へ" Padding="10,4" Command="{Binding NextCommand}"/>
            <TextBlock Grid.Column="4" Text="音量" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider Grid.Column="5" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    Value="{Binding Volume}"/>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="6" Margin="0,8,0,0" Opacity="0.8" TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>
