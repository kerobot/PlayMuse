<Window x:Class="PlayMuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlayMuse"
        xmlns:converters="clr-namespace:PlayMuse.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PlayMuse" Height="700" Width="560" MinHeight="700" MinWidth="560"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="False"
        Background="{StaticResource MetalPanelBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter"/>
        <converters:SampleRateToStringConverter x:Key="SampleRateToStringConverter"/>
        <converters:BitsPerSampleToStringConverter x:Key="BitsPerSampleToStringConverter"/>
        <converters:DraggingOpacityConverter x:Key="DraggingOpacityConverter"/>
        <converters:CurrentTrackBackgroundConverter x:Key="CurrentTrackBackgroundConverter"/>
        <converters:CurrentTrackForegroundConverter x:Key="CurrentTrackForegroundConverter"/>
        <converters:CurrentTrackIconVisibilityConverter x:Key="CurrentTrackIconVisibilityConverter"/>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- カスタムタイトルバー -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="10,0,6,0"
                     VerticalAlignment="Center" Fill="{StaticResource LedGlowBrush}"/>
            <TextBlock Grid.Column="1" Text="PLAYMUSE" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontWeight="Bold" FontSize="11" Margin="2,0,0,0"
                       shell:WindowChrome.IsHitTestVisibleInChrome="False"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="MinimizeButton_Click" ToolTip="最小化"/>
                <Button Content="✕" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="CloseButton_Click" ToolTip="閉じる"/>
            </StackPanel>
        </Grid>

        <!-- ツールバー: ファイルを開く / 出力デバイス選択 / 排他モード切替 -->
        <DockPanel Grid.Row="1" Margin="12,8,12,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="OPEN" Padding="12,4"
                    Command="{Binding OpenFilesCommand}"/>
            <Button DockPanel.Dock="Left" Content="📂" Padding="8,4" Margin="4,0,0,0"
                    ToolTip="プレイリストを開く"
                    Command="{Binding OpenPlaylistCommand}"/>
            <Button DockPanel.Dock="Left" Content="💾" Padding="8,4" Margin="4,0,0,0"
                    ToolTip="プレイリストを保存"
                    Command="{Binding SavePlaylistCommand}"/>
            <ComboBox DockPanel.Dock="Right" Width="240"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox DockPanel.Dock="Right" Content="EXCLUSIVE MODE" VerticalAlignment="Center" Margin="0,0,8,0"
                      IsChecked="{Binding IsExclusiveMode}"/>
        </DockPanel>

        <!-- プレイリスト -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding SelectedTrack}"
                 BorderThickness="1"
                 AllowDrop="True"
                 Grid.IsSharedSizeScope="True"
                 DragOver="TrackList_DragOver"
                 DragLeave="TrackList_DragLeave"
                 Drop="TrackList_Drop">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <EventSetter Event="MouseDoubleClick" Handler="TrackItem_MouseDoubleClick"/>
                    <Setter Property="Opacity">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource DraggingOpacityConverter}">
                                <Binding/>
                                <Binding Path="DataContext.DraggingTrack" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackGrip"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackArt"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackAlbum"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackRemove"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⠿" FontSize="16" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Cursor="SizeAll" ToolTip="ドラッグして並べ替え"
                                   PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                   PreviewMouseMove="DragHandle_PreviewMouseMove"/>
                        <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,8,0"
                                Background="{StaticResource PanelMidBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Image Source="{Binding AlbumArtData, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔊" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource CurrentTrackIconVisibilityConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.CurrentTrack" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                            <Binding Path="DataContext.PlaybackStatus" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource CurrentTrackForegroundConverter}" FallbackValue="{StaticResource TextPrimaryBrush}">
                                            <Binding/>
                                            <Binding Path="DataContext.CurrentTrack" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                            <Binding Path="DataContext.PlaybackStatus" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="90">
                            <TextBlock Text="{Binding Album}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}" FontSize="10" Opacity="0.6"/>
                                <TextBlock Text=" ・ " FontSize="10" Opacity="0.4"/>
                                <TextBlock Text="{Binding SampleRate, Converter={StaticResource SampleRateToStringConverter}}" FontSize="10" Opacity="0.6"/>
                                <TextBlock Text=" / " FontSize="10" Opacity="0.4"/>
                                <TextBlock Text="{Binding BitsPerSample, Converter={StaticResource BitsPerSampleToStringConverter}}" FontSize="10" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                ToolTip="プレイリストから削除"
                                Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="🗑" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- TRACK INFOMATION ヘッダー -->
        <DockPanel Grid.Row="3" Margin="12,8,12,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="TRACK INFOMATION" VerticalAlignment="Center"
                      IsChecked="{Binding IsTrackInfoVisible}"/>
        </DockPanel>

        <!-- オーディオ情報パネル -->
        <Border x:Name="TrackInfoPanel" Grid.Row="4" Margin="12,8,12,0" Padding="8" ClipToBounds="True"
                Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1">
            <TextBlock Text="{Binding AudioInfoText}"
                       Foreground="{StaticResource AccentGlowBrush}"
                       FontFamily="Consolas, Courier New"
                       FontSize="11"
                       LineHeight="18"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- SPECTRUM ANALYZER ヘッダー -->
        <DockPanel Grid.Row="5" Margin="12,8,12,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="SPECTRUM ANALYZER" VerticalAlignment="Center"
                      IsChecked="{Binding IsSpectrumVisible}"/>
        </DockPanel>

        <!-- スペアナ表示欄 -->
        <Border x:Name="SpectrumPanel" Grid.Row="6" Margin="12,8,12,0" ClipToBounds="True"
                Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="SpectrumCanvas" Grid.Row="0" SizeChanged="SpectrumCanvas_SizeChanged"/>
                <Grid x:Name="SpectrumLabelsGrid" Grid.Row="1" Margin="2,2,2,2"/>
            </Grid>
        </Border>

        <!-- 再生中のトラック情報 -->
        <Grid Grid.Row="7" Margin="12,8,12,0" Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="♪" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTrack.Artist, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" - " Margin="4,0" Opacity="0.7"/>
                <TextBlock Text="{Binding CurrentTrack.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ToggleButton Grid.Column="2" 
                          IsChecked="{Binding IsLoopEnabled}"
                          Padding="8,2"
                          Margin="8,0,0,0"
                          ToolTip="ループ再生">
                <TextBlock>
                    <Run Text="🔁"/>
                </TextBlock>
            </ToggleButton>
        </Grid>

        <!-- シーク -->
        <Grid Grid.Row="8" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding Position, Converter={StaticResource TimeSpanToStringConverter}}"/>
            <Slider Grid.Column="1" VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}, ConverterParameter=EnsureNonZero}"
                    Value="{Binding Position, Converter={StaticResource TimeSpanToSecondsConverter}, Mode=TwoWay}"
                    PreviewMouseDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"/>
        </Grid>

        <!-- 再生系トランスポート + 音量 -->
        <Grid Grid.Row="9" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="PREV" Padding="10,4" Margin="0,0,4,0" Command="{Binding PreviousCommand}"/>
            <Button Grid.Column="1" Content="{Binding PlayPauseButtonText}" Padding="10,4" Margin="0,0,4,0" Command="{Binding PlayPauseCommand}"/>
            <Button Grid.Column="2" Content="NEXT" Padding="10,4" Command="{Binding NextCommand}"/>
            <TextBlock Grid.Column="4" Text="VOLUME" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider Grid.Column="5" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    Value="{Binding Volume}"/>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="10" Margin="12,8,12,10" Opacity="0.8" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="{Binding StatusMessage}"/>
    </Grid>
    </Border>
</Window>
