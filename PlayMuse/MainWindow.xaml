<Window x:Class="PlayMuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlayMuse"
        xmlns:converters="clr-namespace:PlayMuse.Converters"
        mc:Ignorable="d"
        Title="PlayMuse" Height="640" Width="440" MinHeight="480" MinWidth="440">
    <Window.Resources>
        <converters:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー: ファイルを開く / 出力デバイス選択 / 排他モード切替 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="開く" Padding="12,4"
                    Command="{Binding OpenFilesCommand}"/>
            <ComboBox DockPanel.Dock="Right" Width="180"
                      ItemsSource="{Binding Devices}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDevice}"/>
            <CheckBox DockPanel.Dock="Right" Content="排他モード" VerticalAlignment="Center" Margin="0,0,8,0"
                      IsChecked="{Binding IsExclusiveMode}"/>
        </DockPanel>

        <!-- プレイリスト -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding SelectedTrack}"
                 BorderThickness="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick" Handler="TrackItem_MouseDoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- オーディオ情報パネル -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" 
                Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1"
                Visibility="{Binding AudioInfoText, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding AudioInfoText}" 
                       FontFamily="Consolas, Courier New" 
                       FontSize="11" 
                       LineHeight="18"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 再生中のトラック情報 -->
        <Grid Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="♪" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTrack.Artist, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" - " Margin="4,0" Opacity="0.7"/>
                <TextBlock Text="{Binding CurrentTrack.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ToggleButton Grid.Column="2" 
                          IsChecked="{Binding IsLoopEnabled}"
                          Padding="8,2"
                          Margin="8,0,0,0"
                          ToolTip="ループ再生">
                <TextBlock>
                    <Run Text="🔁"/>
                </TextBlock>
            </ToggleButton>
        </Grid>

        <!-- シーク -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding Position, Converter={StaticResource TimeSpanToStringConverter}}"/>
            <Slider Grid.Column="1" VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                    Value="{Binding Position, Converter={StaticResource TimeSpanToSecondsConverter}, Mode=TwoWay}"
                    PreviewMouseDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"/>
        </Grid>

        <!-- 再生系トランスポート + 音量 -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="前へ" Padding="10,4" Margin="0,0,4,0" Command="{Binding PreviousCommand}"/>
            <Button Grid.Column="1" Content="{Binding PlayPauseButtonText}" Padding="10,4" Margin="0,0,4,0" Command="{Binding PlayPauseCommand}"/>
            <Button Grid.Column="2" Content="次へ" Padding="10,4" Command="{Binding NextCommand}"/>
            <TextBlock Grid.Column="4" Text="音量" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider Grid.Column="5" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    Value="{Binding Volume}"/>
        </Grid>

        <!-- ステータス -->
        <TextBlock Grid.Row="6" Margin="0,8,0,0" Opacity="0.8" TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>
